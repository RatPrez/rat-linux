#!/usr/bin/env bash
# rat: control script for a rat-linux checkout.
#
#   rat help           show this
#   rat update          git pull, upgrade the system (pacman/yay/flatpak),
#                        then apply pending patches
#   rat patch-status    show which patch this machine is currently up to
set -euo pipefail

RAT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export RAT_DIR
# shellcheck source=lib/common.sh
source "$RAT_DIR/lib/common.sh"
# shellcheck source=lib/patches.sh
source "$RAT_DIR/lib/patches.sh"
# shellcheck source=lib/categories.sh
source "$RAT_DIR/lib/categories.sh"

cmd_update() {
  require_not_root
  sudo_keepalive

  log "Pulling latest rat-linux ($RAT_DIR)"
  git -C "$RAT_DIR" pull --ff-only

  log "System update: pacman -Syu"
  sudo pacman -Syu

  if command -v yay >/dev/null 2>&1; then
    log "System update: yay -Syu (AUR)"
    yay -Syu
  fi

  if command -v flatpak >/dev/null 2>&1; then
    if cat_is_selected "updater" "flatpak-update" "$CATEGORIES_DIR/updater.toml"; then
      log "System update: flatpak update"
      flatpak update -y
    else
      log "Flatpak updates disabled (Updater category); skipping."
    fi
  fi

  run_pending_patches

  ok "rat update complete"
}

cmd_patch_status() {
  mkdir -p "$state_dir"
  log "Current patch level: $(current_patch_level)"
}

usage() {
  cat <<EOF
rat: control script for this rat-linux checkout ($RAT_DIR)

Usage: rat <command>

Commands:
  update          git pull, upgrade the system (pacman/yay/flatpak),
                  then apply pending patches
  patch-status    show which patch this machine is currently up to
  help            show this help
EOF
}

case "${1:-help}" in
  update)       cmd_update ;;
  patch-status) cmd_patch_status ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    usage
    exit 1
    ;;
esac
