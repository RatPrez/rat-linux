#!/usr/bin/env bash
# rat — control script for a rat-linux checkout.
#
#   rat help           show this
#   rat update          git pull, re-run install steps, apply pending
#                        patches, then upgrade the system (pacman/yay/flatpak)
#   rat nvidia          switch between open-source and proprietary Nvidia drivers
#   rat patch-status    show which patch this machine is currently up to
set -euo pipefail

RAT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export RAT_DIR
# shellcheck source=lib/common.sh
source "$RAT_DIR/lib/common.sh"
# shellcheck source=lib/nvidia.sh
source "$RAT_DIR/lib/nvidia.sh"

state_dir="$HOME/.local/state/rat-linux"
level_file="$state_dir/patch-level"

current_patch_level() {
  [[ -f "$level_file" ]] && cat "$level_file" || echo 0
}

# Run every patches/NNNN-*.sh newer than the tracked level, oldest first.
# Stops at the first failure so nothing after a broken patch is applied.
run_pending_patches() {
  mkdir -p "$state_dir"
  local current ran=0
  current="$(current_patch_level)"

  shopt -s nullglob
  local patches=("$RAT_DIR"/patches/[0-9][0-9][0-9][0-9]-*.sh)
  shopt -u nullglob

  local p base num
  for p in "${patches[@]}"; do
    base="$(basename "$p")"
    num=$((10#${base%%-*}))
    (( num > current )) || continue

    log "Applying patch $base"
    if ( set -euo pipefail; source "$RAT_DIR/lib/common.sh"; source "$p" ); then
      echo "$num" > "$level_file"
      ok "Patch $base applied"
      ran=$((ran + 1))
    else
      die "Patch $base failed — fix it and re-run 'rat update'. Nothing after it will run until it does."
    fi
  done

  if [[ "$ran" -eq 0 ]]; then
    ok "No pending patches"
  else
    ok "$ran patch(es) applied"
  fi
}

cmd_update() {
  require_not_root
  sudo -v

  log "Pulling latest rat-linux ($RAT_DIR)"
  git -C "$RAT_DIR" pull --ff-only

  log "Re-running install steps (packages, dotfiles, config)"
  "$RAT_DIR/install.sh"

  run_pending_patches

  log "System update: pacman -Syu"
  sudo pacman -Syu

  if command -v yay >/dev/null 2>&1; then
    log "System update: yay -Syu (AUR)"
    yay -Syu
  fi

  if command -v flatpak >/dev/null 2>&1; then
    log "System update: flatpak update"
    flatpak update -y
  fi

  ok "rat update complete"
}

cmd_patch_status() {
  mkdir -p "$state_dir"
  log "Current patch level: $(current_patch_level)"
}

cmd_nvidia() {
  require_not_root

  if ! detect_gpu_vendors | grep -qx nvidia; then
    warn "No Nvidia GPU detected via lspci — continuing anyway since you asked."
  fi

  local current default answer chosen
  current="$(current_nvidia_variant)"
  default="${current:-open}"

  if [[ -r /dev/tty ]]; then
    printf 'Nvidia driver — [o]pen-source / [p]roprietary (current: %s) [%s]: ' \
      "${current:-none}" "$default" > /dev/tty
    read -r answer < /dev/tty || answer=""
  else
    die "rat nvidia needs a TTY to ask which driver to switch to. Set RAT_NVIDIA_DRIVER=open|proprietary and re-run non-interactively instead."
  fi
  answer="${answer:-$default}"

  case "${answer,,}" in
    p|proprietary) chosen="proprietary" ;;
    o|open)        chosen="open" ;;
    *) die "Unrecognized answer: $answer (expected o/open or p/proprietary)" ;;
  esac

  if [[ "$chosen" == "$current" ]]; then
    ok "Already on $chosen — nothing to do."
    return
  fi

  sudo -v
  install_nvidia_driver "$chosen"
  warn "Reboot required for the new driver to take effect: sudo reboot"
}

usage() {
  cat <<EOF
rat — control script for this rat-linux checkout ($RAT_DIR)

Usage: rat <command>

Commands:
  update          git pull, re-run install steps, apply pending patches,
                  then upgrade the system (pacman/yay/flatpak)
  nvidia          switch between open-source and proprietary Nvidia drivers
  patch-status    show which patch this machine is currently up to
  help            show this help
EOF
}

case "${1:-help}" in
  update)       cmd_update ;;
  nvidia)       cmd_nvidia ;;
  patch-status) cmd_patch_status ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    usage
    exit 1
    ;;
esac
